# App
DEBUG=true

# Network & Security
CORS_ORIGINS='["http://localhost:5173", "http://localhost:5174"]'
TRUSTED_HOSTS='["localhost", "::1", "127.0.0.1"]'

# Proxy: IPs trusted to send real client IP
FORWARDED_ALLOW_IPS="127.0.0.1, 10.0.0.5, 192.168.1.50"

# Redis (Upstash)
REDIS_URL="redis://localhost:6379/0"

# Auth
# Min 32 bytes; generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY="change-me"
# Must be a Fernet key; generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="change-me"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
