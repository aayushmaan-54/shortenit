# Copy to `.env` and fill values; anything not listed here uses defaults from `app/core/config.py`

# --------------- App ---------------
DEBUG=true
FRONTEND_ORIGIN="http://localhost:5173"

# --------------- Network & Security ---------------
CORS_ORIGINS='["http://localhost:5173", "http://localhost:5174"]'
TRUSTED_HOSTS='["localhost", "::1", "127.0.0.1"]'

# Proxy IPs trusted to send real client IP; read by uvicorn from the real env, not this file
FORWARDED_ALLOW_IPS="127.0.0.1, 10.0.0.5, 192.168.1.50"

# --------------- Redis ---------------
REDIS_URL="redis://localhost:6379/0"

# --------------- MongoDB ---------------
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="shortenit"

# --------------- Auth ---------------
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(64))"

# JSON map of kid -> key (min 32 bytes each); last key signs, older ones only verify
JWT_SIGNING_KEYS='{"key-v1": "change-me"}'

# HMAC key for OTP hashing (min 32 bytes)
OTP_SECRET_KEY="change-me"

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="change-me"

# Durations: "30s", "15m", "7d"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# --------------- AWS ---------------
AWS_ACCESS_KEY="change-me"
AWS_SECRET_ACCESS_KEY="change-me"
AWS_DEFAULT_REGION="ap-south-1"

# SES: sender must be a verified identity (sandbox: recipients too)
AWS_SES_SOURCE_EMAIL="ShortenIt <no-reply@example.com>"
